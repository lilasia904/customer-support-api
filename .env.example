# Application environment
NODE_ENV=development

# Application port
PORT=3000

# Application origin
APP_ORIGIN=http://localhost:3000

# SQLite database storage directory
# For local development, use your project folder.
# For production, configure persistent storage.
DATA_DIR=.

# Administrator credentials
ADMIN_USERNAME=admin

# Generate a unique, strong secret.
# Never commit the real value.
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Generate a bcrypt hash of your administrator password.
# Never commit your actual password.
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH